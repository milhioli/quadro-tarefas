# Ambiente do deploy (docker compose). NÃO guarde o arquivo real dentro do repositório:
#   Windows: %USERPROFILE%\.quadro\deploy.env
#   VPS:     /etc/quadro/deploy.env  (chmod 600)
# e passe sempre com --env-file. Valores com $ vão entre aspas simples.

# --- Site ---
# Teste local: localhost. VPS: o domínio (ex.: quadro.seudominio.com.br), com o DNS apontando para a VPS.
APP_DOMAIN=localhost
# A mesma coisa com https://. É também a base do redirect do Google.
APP_ORIGIN=https://localhost
# Onde o Caddy escuta. Teste local: 127.0.0.1. VPS: o IPv4 público da VPS.
BIND_IP=127.0.0.1
# HSTS em segundos. Teste local: 0. VPS: 31536000 ou mais (confira com curl -sI).
HSTS_MAX_AGE=0

# --- Login com Google ---
# No teste local, o client de teste com o redirect https://localhost/api/auth/google/callback.
# Na VPS, um client só de produção (de preferência noutro projeto do Google), publicado,
# com o redirect https://<domínio>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Quem entrar com este e-mail vira o admin (_00).
QUADRO_ADMIN_EMAIL=

# --- Privacidade (aparecem na /privacidade e no rodapé) ---
QUADRO_CONTACT_EMAIL=
# Quem responde pelo app (nome ou empresa).
QUADRO_OPERATOR_NAME=
# Tamanho máximo do banco em MiB (acima disso, criar e editar tarefas param).
QUADRO_DB_MAX_MB=1024

# --- Backup (Litestream) ---
# Teste local: ./litestream.local.yml (réplica em arquivo, poda de 1 h).
# VPS: ./litestream.yml (bucket). Obrigatório escolher.
LITESTREAM_CONFIG=./litestream.local.yml
# Só para o litestream.yml (VPS). O bucket é privado e a chave vale só para ele.
LITESTREAM_BUCKET=
LITESTREAM_PATH=quadro
# Vazio para a AWS; o endpoint do provedor para B2 ou R2.
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
