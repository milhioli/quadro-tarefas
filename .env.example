# Copie para .env somente se quiser mudar os padrões. Nenhuma chave é obrigatória.

# Porta da API Fastify (sempre em 127.0.0.1). Padrão: 3001
API_PORT=

# Porta do frontend Vite (sempre em 127.0.0.1). Padrão: 5173
WEB_PORT=

# Caminho do arquivo SQLite. Padrão: server/data/quadro.sqlite
DB_PATH=

# --- Agenda da Apple (opcional, somente leitura) ---
# Só é usada com `npm run dev:agenda`; o `npm run dev` ignora estas chaves.
# Gere uma SENHA DE APP (não a senha do Apple ID) em account.apple.com >
# Entrar e segurança > Senhas de app, com o nome "quadro-tarefas".
# Ela vale para todo o iCloud (e-mail, contatos e agenda); revogue quando quiser.
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
# Calendários a incluir, separados por vírgula (vazio = todos). Prefira só os pessoais.
ICLOUD_CALENDARS=
