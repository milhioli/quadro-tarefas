# Copie para .env na raiz (desenvolvimento). Sem as chaves do login Google, o app sobe, mas ninguém consegue entrar.
# O deploy usa outro arquivo, fora do repositório: veja deploy/.env.example e docs/deploy.md.
# Não ponha NODE_ENV aqui: o modo público (produção) só liga pelo pacote de deploy.

# Porta da API Fastify (sempre em 127.0.0.1). Padrão: 3001
API_PORT=

# Porta do frontend Vite (sempre em 127.0.0.1). Padrão: 5173
WEB_PORT=

# Caminho do arquivo SQLite. Padrão: server/data/quadro.sqlite
DB_PATH=

# --- Login com Google (veja "Login com Google" no README) ---
# Origem do app no navegador. No desenvolvimento, só 127.0.0.1 ou localhost, na porta do Vite.
# Padrão: http://127.0.0.1:5173 (o redirect do Google sai daqui).
APP_ORIGIN=
# ID do cliente OAuth do tipo "Aplicativo da Web", com o redirect
# http://127.0.0.1:5173/api/auth/google/callback. Os dois vêm juntos, ou nenhum.
GOOGLE_CLIENT_ID=
# O segredo sai do ambiente assim que o servidor o lê e nunca vai para o log.
GOOGLE_CLIENT_SECRET=
# Seu e-mail do Google. Quem entrar com ele primeiro vira o admin (número 00)
# e fica com as tarefas que já existiam. Isso é decidido uma vez só.
QUADRO_ADMIN_EMAIL=

# --- Privacidade (rodapé e /privacidade; obrigatórios no deploy) ---
# Canal de privacidade e de incidente.
QUADRO_CONTACT_EMAIL=
# Quem responde pelo app (nome ou empresa).
QUADRO_OPERATOR_NAME=
# Tamanho máximo do banco em MiB; acima disso, criar e editar tarefas param. Padrão: 1024
QUADRO_DB_MAX_MB=

# --- Agenda da Apple (opcional, somente leitura) ---
# Só é usada com `npm run dev:agenda`; o `npm run dev` ignora estas chaves.
# Gere uma SENHA DE APP (não a senha do Apple ID) em account.apple.com >
# Entrar e segurança > Senhas de app, com o nome "quadro-tarefas".
# Ela vale para todo o iCloud (e-mail, contatos e agenda); revogue quando quiser.
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
# Calendários a incluir, separados por vírgula (vazio = todos). Prefira só os pessoais.
ICLOUD_CALENDARS=
